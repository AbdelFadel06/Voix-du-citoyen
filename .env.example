# Django
SECRET_KEY=changer-moi
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Envoi des codes OTP (WhatsApp ou SMS). Le backend console les affiche dans le terminal.
SMS_BACKEND=apps.core.sms.backends.console.ConsoleSMS
# NotifyHub : SMS_BACKEND=apps.core.sms.backends.notifyhub.NotifyHubSMS, puis
# NOTIFYHUB_CLE=gd_test_...            (clé Sandbox : rien ne part ; clé de production pour l'envoi réel)
# NOTIFYHUB_WHATSAPP_MODELE=nom_du_modele   (modèle « Authentification » approuvé par Meta, variable = code)
# NOTIFYHUB_WHATSAPP_LANGUE=fr
# NOTIFYHUB_SMS_EXPEDITEUR=             (Sender ID approuvé ; vide = codes par WhatsApp seulement)
# NOTIFYHUB_URL=https://api-notifyhub.group-dev.com/api/v1

# Envoi des notifications push. Le backend console les affiche dans le terminal.
PUSH_BACKEND=apps.core.push.backends.console.ConsolePush

# Base de données PostgreSQL (lancée avec docker compose)
POSTGRES_DB=voix_citoyen
POSTGRES_USER=voix_citoyen
POSTGRES_PASSWORD=changer-moi
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Production uniquement (DJANGO_SETTINGS_MODULE=config.settings.prod)
# ---------------------------------------------------------------------------
# SECRET_KEY : longue valeur aléatoire, différente du dev (python -c "import secrets; print(secrets.token_urlsafe(64))")
# ALLOWED_HOSTS=api.exemple.bj
# CORS_ALLOWED_ORIGINS=https://mairie.exemple.bj
# CSRF_TRUSTED_ORIGINS=https://api.exemple.bj
# SMS_BACKEND et PUSH_BACKEND : vrais fournisseurs obligatoires (le serveur refuse de démarrer sinon)
# LOG_LEVEL=INFO
#
# Stockage objet S3-compatible pour les photos, vidéos et audios (sinon : disque local media/)
# USE_S3=True
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_STORAGE_BUCKET_NAME=voix-du-citoyen
# AWS_S3_ENDPOINT_URL=https://s3.fournisseur.exemple
# AWS_S3_REGION_NAME=...
#
# gunicorn (facultatif)
# GUNICORN_WORKERS=5
# FORWARDED_ALLOW_IPS=127.0.0.1
#
# E-mails (codes « mot de passe oublié » de la mairie et des organisations).
# Sans réglage, ils s'affichent dans les journaux ; en production, un vrai service SMTP est obligatoire.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# DEFAULT_FROM_EMAIL=Voix du Citoyen <no-reply@piecitizenvoice.com>
#
# Cookie `refresh` du site web (en-tête X-Client: web). Le site et l'API doivent partager le même
# domaine principal (ex. osc.piecitizenvoice.com et api.piecitizenvoice.com).
# REFRESH_COOKIE_NOM=vdc_refresh
# REFRESH_COOKIE_DOMAINE=            (vide = domaine de l'API, recommandé)
# REFRESH_COOKIE_SAMESITE=Lax        (None seulement si le site est sur un tout autre domaine)
# CORS_ALLOWED_ORIGINS doit contenir l'adresse du site web (ex. https://osc.piecitizenvoice.com).
#
# Limite d'appels par clé d'API d'institution (plateforme IBDC). Défaut : 600/minute.
# CLE_API_DEBIT=600/minute
