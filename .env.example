# Django
SECRET_KEY=changer-moi
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Envoi des SMS (codes OTP). Le backend console les affiche dans le terminal.
SMS_BACKEND=apps.core.sms.backends.console.ConsoleSMS

# Envoi des notifications push. Le backend console les affiche dans le terminal.
PUSH_BACKEND=apps.core.push.backends.console.ConsolePush

# Base de données PostgreSQL (lancée avec docker compose)
POSTGRES_DB=voix_citoyen
POSTGRES_USER=voix_citoyen
POSTGRES_PASSWORD=changer-moi
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Production uniquement (DJANGO_SETTINGS_MODULE=config.settings.prod)
# ---------------------------------------------------------------------------
# SECRET_KEY : longue valeur aléatoire, différente du dev (python -c "import secrets; print(secrets.token_urlsafe(64))")
# ALLOWED_HOSTS=api.exemple.bj
# CORS_ALLOWED_ORIGINS=https://mairie.exemple.bj
# CSRF_TRUSTED_ORIGINS=https://api.exemple.bj
# SMS_BACKEND et PUSH_BACKEND : vrais fournisseurs obligatoires (le serveur refuse de démarrer sinon)
# LOG_LEVEL=INFO
#
# Stockage objet S3-compatible pour les photos, vidéos et audios (sinon : disque local media/)
# USE_S3=True
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_STORAGE_BUCKET_NAME=voix-du-citoyen
# AWS_S3_ENDPOINT_URL=https://s3.fournisseur.exemple
# AWS_S3_REGION_NAME=...
#
# gunicorn (facultatif)
# GUNICORN_WORKERS=5
# FORWARDED_ALLOW_IPS=127.0.0.1
